{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liquidity Analysis Engine",
  "version": "1.0.0",
  "identifier": "com.liquidityanalysisengine.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Liquidity Analysis Engine",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "backgroundColor": "#f2ede1"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": ["binaries/*"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
