# I segreti del sistema. Copia questo file in .env e riempi i valori.
# .env non entra mai in git.

# Il dominio a cui risponde il sito. Caddy ci chiede il certificato.
# .app impone HTTPS a livello di browser (HSTS preload): su questo dominio
# non esiste una versione in chiaro, nemmeno per sbaglio.
SITE_DOMAIN=liquidityengine.app

# Firma i cookie di sessione. Cambiarlo scollega tutti: nient'altro.
# Generane uno nuovo con:  openssl rand -hex 32
SESSION_SECRET=

# Bot Telegram che manda gli avvisi (da BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Dove finiscono i messaggi di SISTEMA: deploy completati, errori 500.
# Gli alert di trading NON passano di qui — vanno alla chat personale di ogni
# utente, quella che ognuno imposta dall'app: sono due canali gia' distinti nel
# codice, e questa riga serve solo a non farli finire nella stessa
# conversazione. Basta un gruppo Telegram nuovo con dentro lo stesso bot
# (nessun bot da ricreare); il suo id lo trovi con
#   cd /opt/liquidity/backend && .venv/bin/python -m tools.telegram_chat_ids
# Gli id dei gruppi sono negativi. Vuota = restano in TELEGRAM_CHAT_IDS.
TELEGRAM_DEV_CHAT_IDS=

# Dati azionari. Senza, le crypto funzionano lo stesso.
TWELVE_DATA_API_KEY=

# Token GitHub per leggere i commit nella notifica di deploy. Facoltativo.
GITHUB_API_TOKEN=

# Proxy fuori UE per le sole chiamate a MEXC futures (contract.mexc.com):
# quell'endpoint puo' rifiutare un IP europeo su /order/submit con un
# blocco di rete (non un errore di chiave — vedi il commento in cima ad
# app/trading/futures/mexc.py). Vuoto = chiamata diretta, comportamento di
# sempre. Formato: http://utente:password@host:porta oppure socks5://host:porta.
# Non tocca gli altri cinque exchange futures, che restano sempre diretti.
MEXC_FUTURES_PROXY=
