# I segreti del sistema. Copia questo file in .env e riempi i valori.
# .env non entra mai in git.

# Il dominio a cui risponde il sito. Caddy ci chiede il certificato.
# .app impone HTTPS a livello di browser (HSTS preload): su questo dominio
# non esiste una versione in chiaro, nemmeno per sbaglio.
SITE_DOMAIN=liquidityengine.app

# Firma i cookie di sessione. Cambiarlo scollega tutti: nient'altro.
# Generane uno nuovo con:  openssl rand -hex 32
SESSION_SECRET=

# Bot Telegram che manda gli avvisi (da BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Dove finiscono i messaggi di SISTEMA: deploy completati, errori 500.
# Gli alert di trading NON passano di qui — vanno alla chat personale di ogni
# utente, quella che ognuno imposta dall'app: sono due canali gia' distinti nel
# codice, e questa riga serve solo a non farli finire nella stessa
# conversazione. Basta un gruppo Telegram nuovo con dentro lo stesso bot
# (nessun bot da ricreare); il suo id lo trovi con
#   cd /opt/liquidity/backend && .venv/bin/python -m tools.telegram_chat_ids
# Gli id dei gruppi sono negativi. Vuota = restano in TELEGRAM_CHAT_IDS.
TELEGRAM_DEV_CHAT_IDS=

# Dati azionari. Senza, le crypto funzionano lo stesso.
TWELVE_DATA_API_KEY=

# Token GitHub: notifica di deploy e analisi del codice del Gem Finder.
# Senza, GitHub concede 60 richieste l'ora e l'analisi si ferma.
GITHUB_API_TOKEN=

# Chiave Anthropic: facoltativa. Le letture del Gem Finder con Claude sono
# spente per scelta (research.AI_ENABLED): i progetti li legge reader.py.
ANTHROPIC_API_KEY=

# Proxy fuori UE per le sole chiamate a MEXC futures (contract.mexc.com):
# quell'endpoint puo' rifiutare un IP europeo su /order/submit con un
# blocco di rete (non un errore di chiave — vedi il commento in cima ad
# app/trading/futures/mexc.py). Vuoto = chiamata diretta, comportamento di
# sempre. Formato: http://utente:password@host:porta oppure socks5://host:porta.
# Non tocca gli altri cinque exchange futures, che restano sempre diretti.
MEXC_FUTURES_PROXY=

# Fase 3 del wallet on-chain: interruttore che accende l'INVIO reale di
# transazioni (Solana + Robinhood Chain insieme, non separabile per chain
# da qui — vedi backend/app/config.py). Nasce assente/false apposta: nessun
# deploy lo accende da solo. Per attivarlo su questo server:
#   1. ssh nel server, cd /opt/liquidity/deploy
#   2. aggiungi ONCHAIN_EXECUTION_ENABLED=true a .env (pydantic-settings
#      legge le env var maiuscole per un campo minuscolo)
#   3. docker compose restart app
# Su Robinhood Chain nessun invio reale e' mai stato provato dal vivo:
# il primo swap vero sara' il primo test reale, non solo su carta.
ONCHAIN_EXECUTION_ENABLED=false

# Chiave che cifra le chiavi dei wallet on-chain, separata da SESSION_SECRET
# (audit 29/09, S07): chi puo' firmare un cookie non puo' piu' decifrare i
# wallet. Vuota: si usa una chiave derivata da SESSION_SECRET, come prima.
# Per accenderla: `openssl rand -hex 32`, salvala ANCHE fuori dal server
# (password manager), mettila qui e riavvia. Ogni wallet passa alla chiave
# nuova la prima volta che viene letto (copia del vecchio record in
# data/wallet_keys_pre_v2.jsonl). MAI toglierla o cambiarla dopo: i wallet
# gia' passati diventerebbero illeggibili.
WALLET_ENCRYPTION_KEY=

# X (Twitter) API v2, Bearer Token di un'app su developer.x.com con accesso in
# lettura (a pagamento). I post recenti sui progetti gia' filtrati entrano nel
# dossier di DeepSeek, al massimo 150 ricerche al giorno. Vuota: X non si legge.
X_BEARER_TOKEN=
